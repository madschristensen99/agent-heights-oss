# Agent Heights environment variables

# ── LLM Providers ─────────────────────────────────────────────────────────
#
# PARETO_INFERENCE_KEY is the primary LLM provider API key (Pareto Inference).
# Pareto is an OpenAI-compatible API offering z-ai/glm-5.3, z-ai/glm-5.3-flash,
# and deepseek/deepseek-v4-flash models. Get a key at https://paretoinference.com
PARETO_INFERENCE_KEY=

# DEEPSEEK_KEY is the fallback LLM provider API key (DeepSeek V4 Flash).
# Used when PARETO_INFERENCE_KEY is not set.
DEEPSEEK_KEY=

# KIMI_KEY is the vision provider API key (Kimi / Moonshot).
# Used for image understanding tasks (e.g. browser screenshots) since
# GLM/DeepSeek models do not support vision input.
KIMI_KEY=

# Hermes gateway model configuration (optional — defaults to pareto/z-ai/glm-5.3-flash)
# Override these to use a different LLM provider/model with the Hermes receptionist.
# HERMES_MODEL_PROVIDER=pareto
# HERMES_MODEL_NAME=z-ai/glm-5.3-flash

# ── Supabase (enables auth + per-user persistence) ────────────────────────
# If not set, the server runs in dev mode (no auth, single shared user,
# file-based persistence in ag/)
#
# For local dev with Supabase CLI:
#   supabase start  (starts local Supabase at http://127.0.0.1:54321)
#   Local anon key and service role key are printed in the output.
#
# For production (cloud Supabase):
#   Create a project at https://supabase.com
#   Run migrations: supabase link --project-ref <ref> && supabase db push
#
# Server-side (read at runtime):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Client-side (Vite requires VITE_ prefix — baked at build time):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Encryption key for per-user API keys (AES-256-GCM) ────────────────────
# 32-byte hex string. Generate with: openssl rand -hex 32
# Required if using per-user API keys with Supabase auth.
ENCRYPTION_KEY=your-encryption-key

# ── Resend (transactional emails: welcome, billing, deletion warnings) ───
# Free tier: 100 emails/day, 3000/month. Sign up at https://resend.com
# Domain agentheights.com is verified via DNS records in Railway.
RESEND_API_KEY=

# ── RevenueCat (iOS in-app purchases via Capacitor) ────────────────────────
# Sign up at https://revenuecat.com — create a project, add an iOS app.
# REVENUECAT_SECRET_KEY: server-side secret API key (for webhook verification + REST API)
# VITE_REVENUECAT_PUBLIC_KEY: public iOS SDK key (injected into client build)
REVENUECAT_SECRET_KEY=
VITE_REVENUECAT_PUBLIC_KEY=

# ── Optional: Marketplace ─────────────────────────────────────────────────
# URL of the marketplace app (used by Office Manager chat proxy)
# MARKETPLACE_URL=http://localhost:3000

# ── Optional: Client WebSocket host ───────────────────────────────────────
# Only needed if the WebSocket is on a different host/port than the page
# (e.g. separate backend deployment). Defaults to location.host.
# For local dev: VITE_WS_HOST=localhost:3001
# For Railway:   VITE_WS_HOST=your-app.up.railway.app
# VITE_WS_HOST=localhost:3001

# ── Optional: Server port ─────────────────────────────────────────────────
# Railway sets this automatically. For local dev, defaults to 3001.
# PORT=3001

# ── Optional: Redis (enables pub/sub, presence, cross-server state) ───────
# If not set, the server runs in single-server mode (in-memory broadcast).
# Set to a Redis connection string to enable horizontal scaling.
# REDIS_URL=redis://localhost:6379

# ── Stripe (enables subscription billing: $0.99 / $4.99 / $19.99 per month) ─
# Get your keys at https://dashboard.stripe.com/apikeys
# Set the webhook secret after creating a webhook endpoint at
# https://dashboard.stripe.com/webhooks (endpoint: /api/stripe/webhook)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Flat sales tax percentage added as a separate line item at checkout (0 = no tax)
SALES_TAX_PERCENT=6

# Public URL of your app (used for Stripe checkout redirect URLs):
VITE_APP_URL=https://agent-heights-production.up.railway.app

# ── Optional: TURN server for WebRTC NAT traversal ─────────────────────────
# Most setups don't need this — STUN (free, Google) handles ~85% of NATs.
# TURN is needed for symmetric NATs (~10–15% of connections).
# Self-host: https://github.com/coturn/coturn
# Managed: Twilio NAT Traversal Service, Xirsys, etc.
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ── Hermes Agent gateway (messaging platform integration) ─────────────────
# The server auto-starts `hermes serve` as a managed child process on port 9119.
# If Hermes is already running externally, the server detects it and skips spawning.
# The Hermes Agent gateway connects to Slack, Discord, Telegram, WhatsApp,
# Signal, Email, and more. See: https://github.com/nousresearch/hermes-agent
# Install: pip install hermes-agent && hermes setup && hermes gateway setup
# HERMES_BASE_URL=http://127.0.0.1:9119

# ── The Singularity Will Be Livestreamed ───────────────────────────────────
# 24/7 autonomous office livestream. See docs/LIVESTREAM.md
#
# Which user's office to spectate (default: dev)
# LIVESTREAM_USER_ID=dev
#
# Headless client + FFmpeg RTMP push (scripts/livestream.ts)
LIVESTREAM_SERVER_URL=http://localhost:3001
RTMP_URL=rtmp://a.rtmp.youtube.com/live2
RTMP_STREAM_KEY=
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# STREAM_FPS=30
# STREAM_BITRATE=3000k
#
# Twitch chat → Office Manager bridge (scripts/chat-bot.ts)
# Get OAuth token: https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=
TWITCH_BOT_NICK=agentheights
TWITCH_CHANNEL=agentheights
# CHAT_COOLDOWN_MS=30000
# CHAT_MAX_LENGTH=500

# ── Optional: DCR Proxy (Cloudflare Worker) ───────────────────────────────
# Bypasses WAF blocks (403) on datacenter IPs for MCP OAuth discovery + DCR.
# Deploy the Worker at scripts/dcr-proxy-worker.js via:
#   https://dash.cloudflare.com/?to=/:account/workers
# Paste the Worker URL here (no trailing slash):
# DCR_PROXY_URL=https://your-worker.your-subdomain.workers.dev

# ── Coinbase CDP Solana Wallets (featured agent capability) ──────────────
# Server-side credentials for auto-provisioning Solana wallets for agents.
# Get them from: https://portal.cdp.coinbase.com/api-keys/secret
# Create a Secret API Key (ECDSA), download the JSON key file, and use the
# "id" field as CDP_API_KEY_ID, "privateKey" as CDP_API_KEY_SECRET.
# CDP_WALLET_SECRET is the wallet secret from the CDP portal.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Solana network: "solana" for mainnet, "solana-devnet" for devnet.
# IMPORTANT: Use "solana" (mainnet) for production — Raydium CLMM program only exists on mainnet.
# Devnet has no Raydium CLMM program and pool creation will fail with "program does not exist".
CDP_SOLANA_NETWORK=solana
# Optional: custom Solana RPC endpoint (Helius/QuickNode) — public endpoints are rate-limited
SOLANA_RPC_URL=

# ── Crossmint Multi-Chain Wallets (curated agent capability) ─────────────
# Server-side credentials for auto-provisioning multi-chain smart wallets
# for agents. Supports EVM (Base, Ethereum, Polygon) and Solana.
# Gas fees are sponsored by Crossmint's paymaster — agents don't need
# native tokens to transact.
# Get them from: https://www.crossmint.com/console/apiKeys
# Create a Server API Key, then generate a Server Signer key pair.
# Use the API key as CROSSMINT_API_KEY and the signer private key as
# CROSSMINT_SERVER_SIGNER_SECRET.
CROSSMINT_API_KEY=
CROSSMINT_SERVER_SIGNER_SECRET=
CROSSMINT_CHAIN=solana
CROSSMINT_ENVIRONMENT=staging

# ── Wizard NPC (World Builder) ───────────────────────────────────────
# A GitHub PAT scoped to the agent-heights repo, used by the in-game
# Wizard NPC to read and modify files on the world's Git branch.
# Create a fine-grained PAT at:
#   https://github.com/settings/personal-access-tokens/new
# Scope it to the agent-heights repo with Contents: Read and Write.
# The Wizard only spawns in deployed world instances (WIZARD_BRANCH must
# NOT be "main" or "master"). It is a premium feature requiring a Pro or
# Business subscription tier to interact with.
WIZARD_GITHUB_PAT=
# The branch the Wizard operates on — set to the world's branch name
# (e.g. "worlds/erics-alley"). Must not be "main" or "master".
WIZARD_BRANCH=main

# ── Circle Gateway (Premium Marketplace Nanopayments) ────────────────────
# Server-side EVM wallet for paying x402-protected API endpoints on behalf
# of agents. Users don't need crypto — costs flow into their subscription
# usage budget. See: https://agents.circle.com/services
#
# Create a wallet on a supported mainnet chain (e.g. Base) and fund it with
# real USDC. For Gateway-compatible services, deposit USDC into the Circle
# Gateway (gasless after deposit). For non-Gateway services, the wallet pays
# directly via x402 exact scheme (EIP-3009, also gasless for the buyer).
# Get started: https://developers.circle.com/gateway/nanopayments/quickstarts/buyer
X402_PRIVATE_KEY=
X402_CHAIN=base
# Legacy aliases (still work):
# CIRCLE_GATEWAY_PRIVATE_KEY=  CIRCLE_CHAIN=base
# Alert when Gateway balance drops below this many USDC
X402_BALANCE_ALERT_THRESHOLD=1
# Safety: max cost per single premium API call (USD)
CIRCLE_MAX_COST_PER_CALL=0.30
# Safety: max premium API calls per agent task
CIRCLE_MAX_CALLS_PER_TASK=20
# Safety: max total premium spend per agent task (USD)
CIRCLE_MAX_TASK_SPEND=0.50

# ── Monid Data Marketplace ────────────────────────────────────────────────
# API key for discover/inspect (free — get one at https://monid.ai)
# Run calls are paid via x402 using the X402_PRIVATE_KEY above (shared).
MONID_API_KEY=

# ── Google Workspace MCP Servers (8 official Google MCP agents) ───────────
# Create a Google Cloud project, enable the Workspace APIs + MCP services,
# configure the OAuth consent screen, and create a Web application OAuth
# client with redirect URI https://agentheights.com/oauth/callback.
# Docs: https://developers.google.com/workspace/guides/configure-mcp-servers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=