{
  "name": "agent-heights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual office where you hire and manage real AI agents (Claude Agent SDK + Codex)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "server": "tsx --env-file=.env server/index.ts",
    "client": "vite",
    "pack-atlas": "tsx scripts/pack-ai-atlas.ts",
    "build": "tsx scripts/pack-ai-atlas.ts && vite build",
    "build:dashboard": "cd dashboard && pnpm install && pnpm build",
    "build:all": "tsx scripts/pack-ai-atlas.ts && vite build && cd dashboard && pnpm install && pnpm build",
    "build:ios": "vite build && npx cap copy ios",
    "cap:add:ios": "npx cap add ios",
    "cap:open:ios": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "dashboard": "cd dashboard && pnpm dev",
    "start": "tsx --env-file=.env server/index.ts",
    "assets": "tsx scripts/generate-assets.ts",
    "ai-assets": "tsx scripts/generate-ai-assets.ts",
    "creature-sprites": "tsx scripts/generate-creature-sprites.ts",
    "creature-3d": "tsx scripts/generate-creature-3d.ts",
    "creature-render": "tsx scripts/render-creature-sprites.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@circle-fin/x402-batching": "^3.2.0",
    "@cline/sdk": "^0.0.51",
    "@coinbase/cdp-sdk": "^1.54.0",
    "@railway/cli": "^4.0.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.62-alpha",
    "@revenuecat/purchases-capacitor": "^13.4.1",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.108.2",
    "@x402/evm": "^2.20.0",
    "adm-zip": "^0.6.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.9",
    "gl-matrix": "^3.4.4",
    "ioredis": "^5.11.1",
    "marked": "^18.0.5",
    "monaco-editor": "^0.56.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^3.11.174",
    "phaser": "^3.90.0",
    "playwright": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "resend": "^6.19.0",
    "stripe": "^22.3.0",
    "three": "^0.185.1",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fal-ai/client": "^1.10.1",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.1.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.9"
  }
}
